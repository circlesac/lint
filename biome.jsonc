{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	// Shared Circles configuration. Consumers keep no Biome config of their own;
	// `@circlesac/lint` passes this file to Biome. Everything not listed is the Biome default.
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/coverage",
			"!**/.wrangler",
			"!**/.next",
			"!**/.open-next",
			"!**/.vercel",
			"!**/.sst",
			"!**/.venv",
			"!**/*.lock",
			"!**/*-lock.json",
			"!**/worker-configuration.d.ts",
			"!**/sst-env.d.ts"
		]
	},
	"formatter": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			// Explicit any is an error, not the default warning (code quality baseline).
			"suspicious": { "noExplicitAny": "error" },
			// A class with only static members is the Circles route unit (static route + static handle).
			"complexity": { "noStaticOnlyClass": "off" }
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
