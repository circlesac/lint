{
  "bin": {
    "lint": "dist/main.js"
  },
  "dependencies": {
    "citty": "^0.2.0",
    "eslint": "^10.0.0",
    "read-package-up": "^12.0.0",
    "typescript-eslint": "^8.54.0"
  },
  "description": "🔧 A zero-config lint tool that uses ESLint, Prettier, and Biome",
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "exports": {
    "./biome": "./biome.jsonc",
    "./eslint": "./eslint.config.mjs",
    "./prettier": "./prettier.config.mjs"
  },
  "files": [
    "dist",
    ".prettierignore",
    "biome.jsonc",
    "eslint.config.mjs",
    "prettier.config.mjs"
  ],
  "keywords": [
    "cli",
    "lint",
    "eslint",
    "prettier",
    "biome",
    "zeroconf"
  ],
  "license": "MIT",
  "main": "dist/main.js",
  "name": "@circlesac/lint",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/circlesac/lint.git"
  },
  "scripts": {
    "build": "bun lint && npx -p @typescript/native-preview tsgo --noEmit && bun run build.ts",
    "dev": "bun run src/main.ts",
    "lint": "bun dev --all",
    "prepublishOnly": "bun run build",
    "start": "bun run build && bun run dist/main.js",
    "test": "vitest run --coverage"
  },
  "type": "module",
  "version": "26.2.2"
}
